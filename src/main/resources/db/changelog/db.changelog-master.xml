<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1" author="Kavin">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="v2" author="Kavin">

        <addColumn tableName="users">
            <column name="password_hash" type="VARCHAR(255)"/>
        </addColumn>

    </changeSet>
    <changeSet id="v3" author="Kavin">

        <addNotNullConstraint
                tableName="users"
                columnName="password_hash"
                columnDataType="VARCHAR(255)"/>

    </changeSet>
    <changeSet id="v4" author="Kavin">

        <addColumn tableName="users">
            <column name="role" type="VARCHAR(255)" defaultValue="USER"/>
        </addColumn>

    </changeSet>

    <changeSet id="v5" author="Kavin">

        <addNotNullConstraint
                tableName="users"
                columnName="role"
                columnDataType="VARCHAR(255)"/>

    </changeSet>
    <changeSet id="v6" author="kavin">

        <createTable tableName="files">

            <column name="id" type="BIGINT"
                    autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="filename" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="files"
                baseColumnNames="owner_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_files_owner"/>

    </changeSet>

    <changeSet id="v7" author="kavin">

        <addColumn tableName="files">
            <column name="storage_path" type="VARCHAR(500)"/>
        </addColumn>

        <update tableName="files">
            <column name="storage_path"
                    valueComputed="CONCAT(owner_id, '/', id)"/>
        </update>

        <addNotNullConstraint
                tableName="files"
                columnName="storage_path"
                columnDataType="VARCHAR(500)"/>

        <addUniqueConstraint
                tableName="files"
                columnNames="storage_path"
                constraintName="uk_files_storage_path"/>

    </changeSet>

    <changeSet id="v8" author="kavin">

        <addColumn tableName="files">
            <column name="content_type" type="VARCHAR(100)"/>
        </addColumn>

    </changeSet>

    <changeSet id="v9" author="kavin">

        <createTable tableName="folders">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="parent_folder_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="folders"
                baseColumnNames="owner_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_folders_owner"/>

        <addForeignKeyConstraint
                baseTableName="folders"
                baseColumnNames="parent_folder_id"
                referencedTableName="folders"
                referencedColumnNames="id"
                constraintName="fk_folders_parent"/>

    </changeSet>

    <changeSet id="v10" author="kavin">

        <!-- Root folders -->
        <sql>
            CREATE UNIQUE INDEX ux_folders_root_name
                ON folders (owner_id, name)
                WHERE parent_folder_id IS NULL;
        </sql>

        <!-- Nested folders -->
        <sql>
            CREATE UNIQUE INDEX ux_folders_nested_name
                ON folders (owner_id, parent_folder_id, name)
                WHERE parent_folder_id IS NOT NULL;
        </sql>

    </changeSet>

    <changeSet id="v11" author="kavin">

        <addColumn tableName="files">
            <column name="folder_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="files"
                baseColumnNames="folder_id"
                referencedTableName="folders"
                referencedColumnNames="id"
                constraintName="fk_files_folder"/>

    </changeSet>

    <changeSet id="v12" author="kavin">

        <addColumn tableName="files">

            <column
                    name="is_trashed"
                    type="BOOLEAN"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column
                    name="trashed_at"
                    type="TIMESTAMP"/>
        </addColumn>

    </changeSet>

    <changeSet id="v13" author="kavin">

        <createTable tableName="revoked_tokens">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="token_hash" type="CHAR(64)">
                <constraints
                        nullable="false"
                        unique="true"/>
            </column>

            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <createIndex
                tableName="revoked_tokens"
                indexName="idx_revoked_tokens_expires_at">

            <column name="expires_at"/>

        </createIndex>

    </changeSet>

    <changeSet id="v14" author="kavin">

        <modifyDataType
                tableName="revoked_tokens"
                columnName="token_hash"
                newDataType="VARCHAR(64)"/>

    </changeSet>

</databaseChangeLog>
